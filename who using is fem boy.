        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local shop = Workspace:FindFirstChild("Shop") and Workspace.Shop:FindFirstChild("VendedorA")
        if hrp and shop then
            local part = shop:FindFirstChild("HumanoidRootPart") or shop:FindFirstChildWhichIsA("BasePart")
            if part then
                hrp.CFrame = part.CFrame * CFrame.new(0, 3, 3)
                btn.Text = "✅ วาร์ปแล้ว"
            end
        else
            btn.Text = "❌ ไม่พบร้าน"
        end
        task.delay(1.2, function() btn.Text = "🌀 วาร์ปไปร้านค้า" end)
    end)
end)

