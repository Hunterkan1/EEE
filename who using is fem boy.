addAction(PageMain, "💥 ฟลิง Rakoof", function(btn)
    pcall(function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            btn.Text = "❌ ไม่พบตัวละคร"
            task.delay(1.2, function() btn.Text = "💥 ฟลิง Rakoof" end)
            return
        end
        local rakeModel
        for _, m in pairs(Workspace:GetDescendants()) do
            if m:IsA("Model") and (m.Name:lower():find("rake") or m.Name:lower():find("rakoof")) then
                if m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head") or m:FindFirstChildWhichIsA("BasePart") then
                    rakeModel = m break
                end
            end
        end
        if rakeModel then
            local part = rakeModel:FindFirstChild("HumanoidRootPart") or rakeModel:FindFirstChild("Head") or rakeModel:FindFirstChildWhichIsA("BasePart")
            if part then
                btn.Text = "⚡ กำลังฟลิง..."
                local bfv = Instance.new("BodyAngularVelocity")
                bfv.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bfv.AngularVelocity = Vector3.new(0, 99999, 0)
                bfv.Parent = hrp
                local orig = hrp.CFrame
                for i = 1, 20 do
                    hrp.CFrame = part.CFrame
                    task.wait(0.02)
                end
                bfv:Destroy()
                hrp.CFrame = orig
                btn.Text = "✅ สำเร็จ!"
            end
        else
            btn.Text = "❌ ไม่พบ Rakoof"
        end
        task.delay(1.2, function() btn.Text = "💥 ฟลิง Rakoof" end)
    end)
end)

